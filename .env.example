# Copy to .env and fill in locally. Never commit .env.
# These are read only by the server-side /api/scan route, never by the app bundle.

# Leave empty to use made-up sample scan results (no AI calls, no cost).
ANTHROPIC_API_KEY=

# Optional overrides.
# SCAN_PROVIDER=mock            # or "anthropic"
# SCAN_MODEL=claude-opus-5-5
